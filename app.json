{
  "expo": {
    "name": "CEO Desk",
    "slug": "ceo-desk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0E11"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ceodesk.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "CEO Desk uses Face ID to protect your private journal, notes, and tasks."
      }
    },
    "android": {
      "package": "com.ceodesk.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "backgroundColor": "#0D0E11",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-sharing"
    ]
  }
}
